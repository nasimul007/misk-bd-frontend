DATABASE_URL="postgresql://misk@localhost:5433/misk_bd"
# Random 32+ byte secret used to hash OTP codes. Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Public site URL, used in password-reset links
APP_URL="http://localhost:3000"
# "console" prints messages to the server log (development only). Production needs a real provider.
SMS_PROVIDER="console"
EMAIL_PROVIDER="console"
# "local" stores uploads in public/uploads (development only). Production needs an object-storage provider.
IMAGE_PROVIDER="local"

# SSLCommerz (card and mobile banking). Leave the id empty to switch the method off.
# Sandbox keys come from the SSLCommerz developer sandbox sign-up. For production set MODE="live" and the
# live store id and password, and make APP_URL your public https address (the gateway calls it back).
SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASSWORD=""
SSLCOMMERZ_MODE="sandbox"
# Protects /api/cron/expire-orders (cancels unpaid online orders). 16+ random characters.
CRON_SECRET=""

# Abuse protection
# The header your host sets to the visitor's real address. Leave empty on Vercel or Cloudflare (detected
# automatically). On any other host, set it to the header your reverse proxy controls, for example "x-real-ip".
CLIENT_IP_HEADER=""
# The most login-code texts to send per day, so a flood of requests can never run up the SMS bill.
SMS_DAILY_CAP="300"
